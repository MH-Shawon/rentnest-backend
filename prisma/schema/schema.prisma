generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum PropertyAvailability {
  AVAILABLE
  RENTED
  UNAVAILABLE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
}

enum PaymentProviderStatus {
  STRIPE
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id       String     @id @default(uuid())
  name     String     @db.VarChar(100)
  email    String     @unique
  password String
  role     Role
  phone    String?
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties      Property[]
  rentalRequestes RentalRequest[]
  payments        Payment[]
  reviews         Review[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  properties Property[]

  @@map("categories")
}

model Property {
  id           String               @id @default(uuid())
  title        String
  description  String
  price        Decimal              @default(0.00) @db.Decimal(10, 2)
  location     String
  city         String
  bedrooms     Int
  bathrooms    Int
  size         Float
  amenities    String[]
  images       String[]
  availability PropertyAvailability
  categoryId   String
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  landlordId   String
  landlord      User                 @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalRequests RentalRequest[]
  reviews        Review[]

  @@map("properties")
}

model RentalRequest {
  id String @id @default(uuid())

  tenantId   String
  tenant     User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  status     RequestStatus @default(PENDING)
  moveInDate DateTime?
  message    String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  payments Payment[]

  @@map("rental_requests")
}

model Payment {
  id              String                @id @default(uuid())
  transactionId   String                @unique
  rentalRequestId String
  rentalRequest   RentalRequest         @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          User                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount          Decimal               @default(0.00) @db.Decimal(10, 2)
  method          String?
  provider        PaymentProviderStatus
  status          PaymentStatus
  paidAt          DateTime?
  createdAt       DateTime              @default(now())

  @@map("payments")
}

model Review {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  @@map("reviews")
}
